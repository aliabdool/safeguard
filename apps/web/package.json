    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy:development": "opennextjs-cloudflare build && wrangler deploy",
    "cf:deploy:demonstration": "opennextjs-cloudflare build && wrangler deploy --env demonstration",
    "cf:deploy:production": "opennextjs-cloudflare build && wrangler deploy --env production"
  },
  "dependencies": {

# Copy to .env.local for local development. Never commit real values.
# See docs/implementation-plan.md for environment setup and docs/system-architecture.md §7
# for the full list of environments (local, development, demonstration, production).

# Public — safe to expose to the browser. The publishable key (Supabase's current name for what
# used to be called the anon key) is meaningless without RLS, which is always enabled and
# FORCE'd (see docs/security-model.md §3).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "demo" only in the Client Demonstration environment — renders the mandatory banner.
NEXT_PUBLIC_APP_ENV=

# Server-only secrets — never prefix with NEXT_PUBLIC_, never reference from src/components or
# src/app/**/page.tsx (see src/server/auth/service-role.ts and eslint.config.mjs).
SUPABASE_SERVICE_ROLE_KEY=

# Pooled Postgres connection (Supabase Supavisor transaction-mode pooler, or Cloudflare
# Hyperdrive in front of it in production — see docs/system-architecture.md §2).
DATABASE_URL=

# Shared secret Cloudflare Cron Triggers present when calling /api/cron/* routes.
CRON_SECRET=

# Zoho Catalyst — apps/web is deployed as a Catalyst AppSail component with catalyst_auth: true set
# in app-config.json, so Catalyst Authentication's /__catalyst/auth/* routes and session resolution
# are same-origin automatically; the hosted-login/logout links are plain relative paths (see
# src/lib/catalyst/env.ts), no project-domain env var needed for that. Session resolution for a
# logged-in request uses the incoming request itself via zcatalyst-sdk-node (no secret needed for
# that path); the three vars below are only for the admin-scoped app used by self-registration,
# audit logging, and rate limiting (src/lib/catalyst/app.ts's catalystAdminApp()) — confirm these
# exact field names against Zoho's admin-initialization docs before relying on them; Catalyst may
# provide them automatically at runtime on AppSail regardless (see chat/commit history).
CATALYST_PROJECT_ID=
CATALYST_PROJECT_KEY=
CATALYST_PROJECT_SECRET_KEY=
